{
  "name": "lemon-watchers",
  "version": "1.0.0",
  "description": "Independent Reactive News Watchers Engine for Lemon Calendarium / Seasons",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc && pnpm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "pnpm run --prefix frontend build",
    "dev:frontend": "pnpm run --prefix frontend start",
    "test": "vitest run test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.3",
    "https-proxy-agent": "^7.0.6",
    "pg": "^8.13.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
